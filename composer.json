{
    "name": "bshaffer/oauth2-server-bundle",
    "type": "symfony-bundle",
    "description": "Symfony OAuth2ServerBundle",
    "keywords": ["oauth", "oauth2", "security"],
    "homepage": "http://github.com/bshaffer/oauth2-server-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Brent Shaffer",
            "email": "bshafs@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "bshaffer/oauth2-server-php": "^1.14",
        "bshaffer/oauth2-server-httpfoundation-bridge": "^1.7.2",
        "doctrine/orm": "^2.20",
        "sensio/framework-extra-bundle": "^6.2",
        "symfony/framework-bundle": "^5.4",
        "symfony/security-core": "^5.4",
        "symfony/twig-bundle": "^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/symfony": "^5.4"
    },
    "autoload": {
        "psr-0": { "OAuth2\\ServerBundle": "" }
    },
    "target-dir": "OAuth2/ServerBundle"
}
